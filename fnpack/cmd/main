#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

CMD="${TRIM_APPDEST}/bin/deepseek.harness"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> ${LOG_FILE}
}

log_err() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "正在启动 deepseek.harness 应用进程..."
    bash -c "${CMD}" &
    local pid=$!
    printf "%s" "${pid}" > ${PID_FILE}

    sleep 1
    if ! check_process "${pid}"; then
        log_err "应用进程启动失败 (进程 PID: ${pid} 意外退出)。"
        rm -f "${PID_FILE}"
        return 1
    fi

    return 0
}

stop_process() {
    log_msg "正在停止 deepseek.harness 应用进程..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "检测到运行中的进程 PID: ${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "进程不存在，已清理残留 PID 文件"
        else
            log_msg "正在向进程 PID: ${pid} 发送 SIGTERM 停止信号..."
            kill -TERM ${pid} >> ${LOG_FILE} 2>&1

            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
                log_msg "等待进程终止... (${count}秒/10秒)"
            done

            if check_process "${pid}"; then
                log_err "进程 PID: ${pid} 未在 10 秒超时内停止，发送 SIGKILL。"
                kill -KILL "${pid}"
                sleep 1
                rm -f "${PID_FILE}"
            else
                log_msg "应用进程已成功停止。"
            fi
        fi
    fi

    pkill -f 'pnpm-env/node_modules/.bin/pnpm dsh web' 2>/dev/null || true

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac